# Adam Configuration
audio:
  target_sink: "default"        # "default", or specific PipeWire node/ALSA sink
  target_source: "default"      # "default", or specific PipeWire source/ALSA mic
  sample_rate: 48000
  chunk_size: 1280
  vad_threshold_idle: 0.45
  vad_threshold_speaking: 0.88
  wake_energy_floor: 0.0005 # Skip wake-model inference below this normalized RMS; set 0 to disable gating
  vad_silence_duration: 1.25  # seconds of sustained silence to finalize utterance (allows natural pauses)
  max_utterance_seconds: 60.0  # hard cap per captured user utterance

wake:
  wake_word: "hey adam"  # Custom phrase (e.g. "hey adam", "hey computer", "hey assistant") or ONNX model ("hey jarvis")
  aliases: []            # Optional list of phonetic spelling variants/aliases (e.g. ["atom", "edam"])
  threshold: 0.50
  followup_window_seconds: 7.0  # continuous conversation window after speaking

stt:
  provider: "local"        # "local" | "openai" | "openrouter" | "custom"
  model_size: "small.en" # Faster-Whisper small.en is the portable CPU default; or "qwen3-asr-1.7b" for Vulkan GPU
  language: ""             # Qwen3-ASR auto-detects; leave empty for auto-detection or language code for whisper
  device: "cpu"
  device_index: -1
  compute_type: "int8"
  cloud_model: "gpt-transcribe"
  cloud_url: "https://api.openai.com/v1/audio/transcriptions"
  api_key: ""
  fallback_model: "base.en"
  fallback_device: "cpu"
  fallback_compute_type: "int8"

speaker_verification:
  enabled: true # Activates only after a local voice profile is enrolled
  threshold: 0.25
  # profile_path: "" # Optional custom path; defaults to ~/.local/state/adam/speaker-profile.npz
  # users: []        # Optional multi-user voice profiles (e.g. [{"name": "User", "profiles": {"default": "path.npz"}}])

speaker_diarization:
  enabled: false # Optional; setup installs NVIDIA's Transformers runtime when enabled
  executable: "nemo-speech" # Retained for compatibility with older configs
  model: "nvidia/Nemotron-3-Diarization"
  device: "auto" # "auto" uses CPU; choose "cpu" or an explicit "cuda:N"; Vulkan is unsupported
  timeout_seconds: 45.0

meeting:
  output_dir: "~/.local/state/adam/meetings"
  max_duration_hours: 4.0
  silence_duration: 1.25
  max_segment_seconds: 30.0
  speaker_similarity_threshold: 0.55

idea_routing:
  enabled: false # Optional wake-free semantic routing; setup installs MiniLM when enabled
  model: "sentence-transformers/all-MiniLM-L6-v2"
  ideas_path: "assets/intent_ideas.json"
  command_threshold: 0.30 # High-confidence direct commands such as "Open Spotify"
  background_threshold: 0.49 # Stricter candidate gate before background LLM review
  minimum_margin: 0.025 # Best idea must beat the runner-up by this cosine margin
  require_enrolled_speaker: true # Avoid treating media/other speakers as Adam's user

browser_navigation:
  enabled: false # Optional Playwright control in Adam's isolated browser profile; normal browsing uses your default browser
  browser: "chromium" # Playwright-managed Chromium; uses Adam's separate browser profile
  profile_path: "~/.local/share/adam/browser-navigation"
  timeout_seconds: 15.0
  headless: false # Set true to keep it invisible and release it after read-only turns

computer_control:
  enabled: true # Screenshot-guided mouse and keyboard control; chooses X11 or Wayland automatically
  max_text_length: 20000 # Maximum characters Adam can enter in one action
  screenshot_delay_seconds: 0.25 # Automatic wait after GUI actions before the next screenshot
  browser_screenshot_delay_seconds: 3.0 # Let browser navigation and controls settle before observing
  max_sequence_actions: 8 # Maximum sequential desktop inputs in one model-selected call
  max_sequence_text_length: 20000 # Total characters typed across one sequence; each action also has max_text_length
  sequence_timeout_seconds: 45.0 # Elapsed-time budget checked between actions; an active action finishes first
  ocr_only: false # When enabled, images stay internal and only OCR text/boxes reach the model
  jev_enabled: false # Use TypeSafe Jev 1.13 for desktop action and target decisions
  jev_api_base: "https://openrouter.ai/api/alpha/decisions"
  jev_model: "typesafe/jev-1.13"
  jev_timeout_seconds: 20.0
  jev_min_confidence: 0.65
  ocr_max_regions: 100
  ocr_max_candidates: 800 # Candidate text boxes parsed from OCR before candidate ranking
  ocr_max_image_dimension: 1280 # Downscale larger screenshots before local OCR; reported boxes map back to screenshot pixels
  ocr_model_size: small # PP-OCRv6 small for lower CPU/RAM; select medium for extra text accuracy
  ocr_preload_on_startup: false # Load OCR on the first screen read to save idle RAM and CPU; enabling reduces first-read latency
  ocr_device: null # Optional: null uses CPU on demand; select cuda to use GPU OCR
  ocr_gpu_uuid: "" # Required with cuda; exact NVIDIA UUID for OCR only

computer_vision:
  enabled: false # Optional OmniParser detector; overlays numbered candidate controls on computer_control screenshots
  backend: "omniparser" # Detector-only: boxes are provided; text labels come from the screenshot/accessibility data
  preload_on_startup: false # Preload OmniParser model on startup; false keeps it lazy-loaded on first visual action
  device: "cpu" # "cpu" or "cuda"; the Ultralytics runtime does not support Vulkan.
  gpu_uuid: "" # Required for CUDA; exact NVIDIA GPU UUID from nvidia-smi -L, so Adam never picks another GPU
  python_path: "~/.local/share/adam/omniparser-runtime/bin/python" # Isolated runtime; keeps Torch out of Adam's main environment
  model_path: "~/.local/share/adam/models/omniparser-yolov8n.pt"
  confidence_threshold: 0.05
  max_regions: 60
  timeout_seconds: 15.0

tts:
  engine: "kokoro"             # "kokoro" | "openai" (cloud speech) | "piper" | "cosyvoice" | "silent" (desktop notifications)
  silent_restore_engine: "kokoro" # Engine restored when silent mode is explicitly disabled
  model_path: "assets/voices/kokoro/kokoro-v1.0.onnx"
  voices_path: "assets/voices/kokoro/voices-v1.0.bin"
  voice: "af_nicole"             # Kokoro voice (e.g. "af_nicole", "am_adam", "am_michael", "af_bella")
  device_id: -1                 # -1 for CPU (AVX-optimized); 0, 1... for explicit CUDA GPU device ID
  speed: 1.1
  sample_rate: 24000
  cloud_model: "gpt-4o-mini-tts"
  cloud_voice: "marin"
  api_key: ""
  # cosyvoice_api_url: "http://localhost:50000"
  # cosyvoice_model_dir: "pretrained_models/CosyVoice2-0.5B"
  # piper_bin: "piper"
  # config_path: "assets/voices/en_US-ryan-high.onnx.json"

llm:
  provider: "local"         # "local" (Ollama) | "groq" | "gemini" | "anthropic" | "openai" | "custom" / "openai_compatible"
  local_model: "qwen3.5:4b"
  cloud_model: "llama-3.3-70b-versatile" # or "gemini-2.5-flash", "claude-3-5-sonnet-20241022", "gpt-4o-mini"
  ollama_host: "http://localhost:11434"
  api_base: ""              # Base URL for custom OpenAI-compatible providers
  api_key: ""               # Optional API key for cloud/custom providers
  provider_only: []          # OpenRouter only: pin to a provider slug, e.g. ["relace"]
  allow_provider_fallbacks: true
  experimental_factual_comparison_review: false # Experimental; adds one bounded review call to standalone comparisons
  tool_free_model: ""        # Optional model for short, generic, tool-free requests
  tool_free_provider_only: []
  tool_free_allow_provider_fallbacks: true
  # disable_reasoning_for_tool_free: false # Set true to omit reasoning tokens for fast tool-free turns
  # tool_free_reasoning_effort: null       # "max" | "xhigh" | "high" | "medium" | "low" | "minimal" | "none"
  num_ctx: 65536             # 64k context window
  temperature: 0.3
  think: false                # Disable model thinking / reasoning prefix (false, true, or level string)
  max_tool_rounds: 64 # Generous per-request model/tool rounds; a ceiling reports partial progress
  request_timeout_seconds: 45.0 # Stop a stalled text request instead of leaving the voice turn hanging
  vision_request_timeout_seconds: 90.0 # Larger bounded budget for screenshot-based reasoning

execution:
  workspace_dir: "~/workspace"
  downloads_dir: "~/Downloads"
  jobs_log_dir: "~/.local/state/adam/jobs"
  max_log_mb: 50
  preferred_video_codec: "av1"

telemetry:
  enabled: false # Optional JSONL runtime event logging for latency and token telemetry
  path: "~/.local/state/adam/telemetry/events.jsonl"

# Desktop application & window aliases (user-customizable)
desktop:
  # Default browser executable or application name (e.g. "microsoft-edge-stable", "firefox", "google-chrome-stable")
  default_browser: "chromium"

  # Aliases used when launching applications (e.g. "open discord", "open cyberpunk")
  application_aliases:
    discord: ["vesktop", "discord", "webcord", "armcord"]
    browser: ["microsoft edge", "google chrome", "firefox", "chromium", "brave"]
    edge: ["microsoft edge", "microsoft edge (beta)"]
    chrome: ["google chrome"]
    terminal: ["alacritty", "kitty", "foot", "konsole", "wezterm", "xterm"]
    music: ["spotify"]
    spotify: ["spotify"]
    code: ["zed", "neovim", "visual studio code", "code", "codium"]
    editor: ["zed", "neovim", "gedit", "micro", "vim"]
    zed: ["zed"]
    resolve: ["davinci resolve"]
    davinci: ["davinci resolve"]
    obs: ["obs studio"]
    steam: ["steam"]
    cyberpunk: ["cyberpunk 2077"]
    cs2: ["counter-strike 2"]
    counter strike: ["counter-strike 2"]
    wukong: ["black myth: wukong"]
    black myth: ["black myth: wukong"]
    hollow knight: ["hollow knight"]
    ultrakill: ["ultrakill"]
    ror2: ["risk of rain 2"]
    risk of rain: ["risk of rain 2"]
    siege: ["tom clancy's rainbow six siege"]
    rainbow six: ["tom clancy's rainbow six siege"]
    street fighter: ["street fighter v"]
    sfv: ["street fighter v"]
    files: ["dolphin", "nautilus", "thunar"]
    file manager: ["dolphin", "nautilus", "thunar"]
    calculator: ["kcalc", "gnome-calculator", "calc"]
    settings: ["kde system settings", "system settings"]

  # Aliases used when focusing, moving, or closing existing windows
  window_aliases:
    browser: ["edge", "microsoft-edge", "chrome", "google-chrome", "firefox", "chromium", "brave", "zen", "vivaldi", "opera"]
    edge: ["microsoft-edge", "microsoftedge", "edge"]
    chrome: ["google-chrome", "chrome"]
    discord: ["vesktop", "webcord", "discord", "armcord"]
    terminal: ["alacritty", "kitty", "foot", "konsole", "wezterm", "ghostty", "xterm"]
    music: ["spotify", "cider", "rhythmbox", "cmus"]
    spotify: ["spotify"]
    code: ["code", "codium", "vscode", "zed", "cursor", "neovim", "sublime"]
    editor: ["code", "codium", "vscode", "zed", "cursor", "neovim", "sublime", "kate"]
    zed: ["dev.zed.zed", "zed"]
    files: ["nautilus", "dolphin", "thunar", "nemo", "pcmanfm"]
    obs: ["com.obsproject.studio", "obs", "obs64"]
    resolve: ["resolve", "davinciresolve"]
    steam: ["steam"]
    cyberpunk: ["cyberpunk2077.exe", "cyberpunk"]
    cs2: ["cs2", "counterstrike"]

  # User-defined macros or compositor actions (DE-agnostic)
  # Adam includes defaults for detected DEs (e.g. KDE: overview, show_desktop, grid, night_mode, lock;
  # Hyprland: toggle_floating, fullscreen, pin, split, lock; Sway: toggle_floating, fullscreen, lock; Niri: toggle_floating, center).
  # You can define custom macros or override defaults here:
  macros:
    overview: "qdbus6 org.kde.kglobalaccel /component/kwin invokeShortcut 'Overview' || qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Overview'"
    show_desktop: "qdbus6 org.kde.kglobalaccel /component/kwin invokeShortcut 'Show Desktop' || qdbus org.kde.kglobalaccel /component/kwin invokeShortcut 'Show Desktop'"
    toggle_floating: "hyprctl dispatch togglefloating active || swaymsg floating toggle || niri msg action toggle-window-floating"
    lock: "loginctl lock-session"

  # Optional explicit list of capabilities or tools to disable manually
  # disabled_capabilities:
  #   - window_swap
  # disabled_tools:
  #   - swap_windows

# User-defined custom tools (YAML declarative command sequences)
# Can also be placed as standalone .yaml files in ~/.config/adam/tools/*.yaml
custom_tools:
  - name: "start_coding_session"
    description: "Switches to workspace 2 and launches editor and dev terminal for a project"
    timeout: -1                  # -1 means straight sequential wait until done (no timeout)
    background: false            # false = synchronous foreground; true = background with proactive notification
    parameters:
      project:
        type: string
        description: "Name of the project folder"
        default: "voice-assistant"
      workspace_id:
        type: integer
        description: "Workspace ID (i.e., 1,2,3,4,5....)"
        default: 0
    commands:
      - "hyprctl dispatch workspace {workspace_id}"
      - "zed ~/workspace/{project} &"
      - "alacritty --working-directory ~/workspace/{project} &"
    success_message: "Started coding session for {project}."
  # Example SSH custom tool:
  # - name: "remote_terminal"
  #   description: "Spawns a terminal and connects to a remote server via SSH"
  #   timeout: 10
  #   background: false
  #   commands:
  #     - "alacritty -e ssh user@example.com &"
  #   success_message: "Connected to remote server."

  - name: "google_calendar_agenda"
    description: "Shows the upcoming Google Calendar agenda using gcalcli. Requires gcalcli OAuth setup."
    timeout: 30
    command: "gcalcli agenda"

  - name: "google_calendar_quick_add"
    description: "Adds an event to Google Calendar from a natural-language description such as 'Lunch with Adam tomorrow at noon'. Requires gcalcli OAuth setup."
    confirm: true
    timeout: 60
    parameters:
      event:
        type: string
        description: "Natural-language event title, date, and time to add"
    command: "gcalcli quick {event}"



  # Example of a background task that informs the user it is waiting:
  # - name: "build_project"
  #   description: "Compiles a project in the background and announces completion"
  #   background: true
  #   timeout: -1
  #   waiting_message: "Starting compilation of {project}. Waiting for build to finish..."
  #   success_message: "Build for {project} completed successfully."
  #   parameters:
  #     project:
  #       type: string
  #       default: "voice-assistant"
  #   commands:
  #     - "cd ~/workspace/{project} && cargo build --release"

# ---------------------------------------------------------
# Optional WebUI Sidecar
# ---------------------------------------------------------
# The WebUI is disabled by default to preserve voice as the primary
# interface. It binds strictly to loopback (127.0.0.1) by default.
webui:
  enabled: false
  host: "127.0.0.1"
  port: 8765
  auth_token: ""  # Optional Bearer token for authentication
